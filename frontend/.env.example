# Backend API base URL used by the frontend.
# Vite exposes this as import.meta.env.VITE_API_BASE_URL at build time.
#
# In dev, set this to your LAN address — the phone inside Nimiq Pay must be
# able to reach it, e.g. VITE_API_BASE_URL=http://192.168.1.100:3001
#
# Do NOT use http://localhost:3001: inside Nimiq Pay, "localhost" means the
# phone itself, not your dev machine.
#
# This value must match the backend's CORS_ORIGIN (minus the port difference:
# CORS_ORIGIN is the frontend's origin, e.g. http://192.168.1.100:5173).
VITE_API_BASE_URL=http://localhost:3001