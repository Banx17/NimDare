{
  // https://aka.ms/tsconfig
  "compilerOptions": {
    // --- File Layout ---
    // Compile TypeScript into the dist/ folder so the built app can be run
    // with `npm run start` (which runs node dist/server.js).
    "rootDir": "./src",
    "outDir": "./dist",

    // --- Module System ---
    // IMPORTANT: package.json sets "type": "commonjs", so this backend runs as
    // CommonJS. Previously tsconfig used "module": "nodenext" with a stale
    // "moduleResolution" setting, which caused compile-time errors because
    // TypeScript assumed ESM resolution while Node was reading the files as
    // CommonJS. "module": "node16" + "moduleResolution": "node16" lets
    // TypeScript correctly resolve both ESM and CJS imports, and because
    // package.json declares "type": "commonjs", all .ts files compile as
    // CommonJS output.
    "module": "node16",
    "moduleResolution": "node16",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],

    // --- Other Outputs ---
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // --- Stricter Typechecking ---
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // --- Recommended ---
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}