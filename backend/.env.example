# NimDare Backend — Environment Variables
#
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
#
# PORT — The port the server listens on.
#        Default: 3001
PORT=3001

# NODE_ENV — "development" or "production".
#           Default: development
NODE_ENV=development

# MONGO_URI — MongoDB connection string.
#              REQUIRED — the server fails fast (exits) if this is missing.
#              Use a local MongoDB instance or an Atlas connection string.
#
#              Local MongoDB (default port 27017). The trailing /nimdare is
#              the database name:
#              mongodb://127.0.0.1:27017/nimdare
#
#              MongoDB Atlas example (replace placeholders — NEVER commit a
#              real credential):
#              mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nimdare
#
# Copy this to .env and replace with your real connection string.
MONGO_URI=mongodb://127.0.0.1:27017/nimdare

# JWT_SECRET — Secret used to sign JSON Web Tokens for wallet authentication.
#              REQUIRED — the server fails fast (exits) if this is missing.
#              Use a long random string in development and a strong secret in
#              production. NEVER commit a real secret — this is a PLACEHOLDER
#              for local development only.
#
#              Generate one locally with:
#                node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
